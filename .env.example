# ==============================================================================
# Environment Configuration for Production Voice AI System
# ==============================================================================

# Hardware & Accelerator
DEVICE=cuda                               # 'cuda', 'cpu', or 'mps'
COMPUTE_TYPE=float16                      # 'float16', 'int8', 'float32'

# HuggingFace Credentials (for downloading gated models like Whisper, LLaMA)
HF_TOKEN=your_huggingface_token_here

# LLM Providers
LLM_PROVIDER=ollama                       # 'ollama', 'openai', or 'mock'
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:8b-instruct-q4_K_M
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Speech-To-Text (STT) Settings
STT_BACKEND=faster-whisper                # 'faster-whisper', 'whisper', 'mock'
STT_MODEL_SIZE=base                       # 'tiny', 'base', 'small', 'medium', 'large-v3'
STT_LANGUAGE=vi                           # 'vi' (Vietnamese), 'en' (English), or 'auto'

# Text-To-Speech (TTS) Settings
TTS_BACKEND=edge-tts                      # 'edge-tts', 'piper', 'mock'
TTS_VOICE=vi-VN-NamMinhNeural             # 'vi-VN-NamMinhNeural', 'vi-VN-HoaiMyNeural', 'en-US-GuyNeural'
TTS_RATE=+0%
TTS_PITCH=+0Hz
PIPER_MODEL_PATH=models/piper/vi_VN-25hours-medium.onnx

# Digital Signal Processing & Hardware
SAMPLE_RATE=16000
CHUNK_SIZE=512
AUDIO_INPUT_DEVICE=default
AUDIO_OUTPUT_DEVICE=default

# Logging Level
LOG_LEVEL=INFO
